{
  "name": "yep-artifact-host",
  "main": ".generated/index.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "node build.mjs" },
  "routes": [
    { "pattern": "*.yepanywhere.com/*", "zone_name": "yepanywhere.com" }
  ],
  "observability": { "enabled": false }
}
